# ──────────────────────────────────────────────────────────────────────────────
# CONFIGURATION MAIL — Exemples pour la production
# Copiez les blocs correspondants dans votre .env (en remplaçant les valeurs)
# ──────────────────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════════════════
#  OPTION A : Resend (RECOMMANDÉ — simple, gratuit jusqu'à 3000 mails/mois)
# ═════════════════════════════════════════════════════════════════════════════
# 1. Créez un compte sur https://resend.com
# 2. Ajoutez votre domaine (universal-tours.com) et configurez les DNS (SPF, DKIM)
# 3. Créez une clé API dans le dashboard
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_XXXXXXXXXX_yourapikey
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@universal-tours.com
# MAIL_FROM_NAME="Universal Tours"


# ═════════════════════════════════════════════════════════════════════════════
#  OPTION B : Brevo (ex-Sendinblue, gratuit jusqu'à 300 mails/jour)
# ═════════════════════════════════════════════════════════════════════════════
# 1. Créez un compte sur https://www.brevo.com
# 2. Récupérez vos identifiants SMTP dans Paramètres → SMTP & API
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=votre_login_smtp@smtp-brevo.com
# MAIL_PASSWORD=votre_master_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@universal-tours.com
# MAIL_FROM_NAME="Universal Tours"


# ═════════════════════════════════════════════════════════════════════════════
#  OPTION C : Gmail / Google Workspace (rapide à mettre en place)
# ═════════════════════════════════════════════════════════════════════════════
# 1. Activez la validation en 2 étapes sur votre compte Google
# 2. Créez un "mot de passe d'application" : Compte → Sécurité → Mots de passe d'application
# 3. Utilisez ce mot de passe (et non votre mdp Google) dans MAIL_PASSWORD
# ⚠️ Limite : ~500 mails/jour, peut être marqué spam par certains destinataires
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=votre.adresse@gmail.com
# MAIL_PASSWORD=mot_de_passe_dapplication_16_chars
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=votre.adresse@gmail.com
# MAIL_FROM_NAME="Universal Tours"


# ═════════════════════════════════════════════════════════════════════════════
#  TEST RAPIDE après config
# ═════════════════════════════════════════════════════════════════════════════
# php artisan tinker
# Mail::raw('Test mail Universal Tours', fn($m) => $m->to('votre@email.com')->subject('Test'));
# → Si pas d'erreur, vérifiez la boîte de réception
